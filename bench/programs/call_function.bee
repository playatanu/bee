# Function-call overhead, on a callee the numeric JIT cannot take.
fn pick(xs, i) { let a = xs[i] return a + 1 }
fn run() {
  let xs = []
  for (let i = 0; i < 1000; i = i + 1) { xs.push(i) }
  let s = 0
  for (let r = 0; r < 3000; r = r + 1) {
    for (let i = 0; i < 1000; i = i + 1) { s = s + pick(xs, i) }
  }
  return s
}
print(run())
