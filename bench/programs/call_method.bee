# Built-in method dispatch on a list. Unlike an instance method, this still
# materialises a Builtin object per call inside getProperty.
fn run() {
  let xs = []
  for (let i = 0; i < 1000; i = i + 1) { xs.push(i) }
  let s = 0
  for (let r = 0; r < 2000; r = r + 1) {
    for (let i = 0; i < 1000; i = i + 1) { s = s + xs.len() }
  }
  return s
}
print(run())
