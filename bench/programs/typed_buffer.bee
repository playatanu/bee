# A numeric kernel over contiguous unboxed memory: declared `buffer` indexed by
# a declared `num`, which needs no tag tests at all.
fn dot(a: buffer, b: buffer, n: num) -> num {
  let s: num = 0
  for (let i: num = 0; i < n; i = i + 1) { s = s + a[i] * b[i] }
  return s
}
fn run() -> num {
  let n: num = 4000
  let a = zeros([4000], "f64")
  let b = zeros([4000], "f64")
  for (let i = 0; i < n; i = i + 1) { a[i] = i * 0.5  b[i] = i * 0.25 }
  let total: num = 0
  for (let r: num = 0; r < 500; r = r + 1) { total = total + dot(a, b, n) }
  return total
}
print(run())
