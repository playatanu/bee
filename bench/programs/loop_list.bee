# Reading a list by index in a nested loop: the commonest shape in real code,
# and outside the numeric JIT's subset.
fn run(n) {
  let xs = []
  for (let i = 0; i < n; i = i + 1) { xs.push(i) }
  let s = 0
  for (let r = 0; r < 3000; r = r + 1) {
    for (let i = 0; i < n; i = i + 1) { s = s + xs[i] }
  }
  return s
}
print(run(3000))
