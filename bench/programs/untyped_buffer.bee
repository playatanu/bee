fn dot(a, b, n) {
  let s = 0
  for (let i = 0; i < n; i = i + 1) { s = s + a[i] * b[i] }
  return s
}
fn run() {
  let n = 4000
  let a = zeros([4000], "f64")
  let b = zeros([4000], "f64")
  for (let i = 0; i < n; i = i + 1) { a[i] = i * 0.5  b[i] = i * 0.25 }
  let total = 0
  for (let r = 0; r < 500; r = r + 1) { total = total + dot(a, b, n) }
  return total
}
print(run())
