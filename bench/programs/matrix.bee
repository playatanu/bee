# Nested lists: two index operations per element.
fn run(n, iters) {
  let m = []
  for (let i = 0; i < n; i = i + 1) {
    let row = []
    for (let j = 0; j < n; j = j + 1) { row.push(i * j) }
    m.push(row)
  }
  let s = 0
  for (let r = 0; r < iters; r = r + 1) {
    for (let i = 0; i < n; i = i + 1) {
      for (let j = 0; j < n; j = j + 1) { s = s + m[i][j] }
    }
  }
  return s
}
print(run(200, 80))
