# The same arithmetic as loop_numeric_fn, with every binding annotated, so the
# compiler can emit the typed opcodes.
fn run(n: num, tag: str) -> num {
  # `tag` keeps this out of the LLVM JIT, so what is measured is the bytecode.
  let s: num = 0
  for (let i: num = 0; i < n; i = i + 1) {
    let j: num = 0
    while (j < 1000) { s = s + (i * j) % 7 j = j + 1 }
  }
  return s
}
print(run(20000, "x"))
