# Byte-for-byte the same program with the annotations removed: the measurement
# of what declaring types is worth.
fn run(n, tag) {
  # `tag` keeps this out of the LLVM JIT, so what is measured is the bytecode.
  let s = 0
  for (let i = 0; i < n; i = i + 1) {
    let j = 0
    while (j < 1000) { s = s + (i * j) % 7 j = j + 1 }
  }
  return s
}
print(run(20000, "x"))
