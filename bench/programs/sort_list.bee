# A built-in that calls back into Bee code for every comparison.
fn cmp(a, b) { return a < b }
fn run(n) {
  let xs = []
  let v = 12345
  for (let i = 0; i < n; i = i + 1) { v = (v * 1103515245 + 12345) % 2147483648 xs.push(v % 100000) }
  let out = 0
  for (let r = 0; r < 6; r = r + 1) { out = out + sort(xs, cmp)[0] }
  return out
}
print(run(40000))
