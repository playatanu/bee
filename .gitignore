# ---- Build artifacts ----------------------------------------------------
# Object files and auto-generated header-dependency files from the Makefile.
*.o
*.d

# The compiled interpreter and package manager (rebuild with `make`).
/bee
/bee.exe
bee.exe
packaging/windows/bee.exe
# The LLVM JIT backend, dlopen'd by bee at run time (rebuild with `make`).
/libbee_jit.so
/libbee_jit.dylib
/bee_jit.dll
/hive
/hive.exe
hive.exe
packaging/windows/hive.exe
/beegen
/beegen.exe
beegen.exe
packaging/windows/beegen.exe

# Scratch directory created by bench/run.sh for its startup-floor probe.
bench/.tmp/

# ---- Hive (package manager) --------------------------------------------
# Installed packages, and archives built by `hive pack`, are never committed;
# hive.json and hive.lock are.
hive_modules/
*.hive

# ---- Native modules ------------------------------------------------------
# Compiled bindings. The generated sources are yours to commit; the .so is not.
*_native.so
*_native.dll
*_native.dylib

# ---- Packaged output ----------------------------------------------------
# Release artifacts produced by packaging/build-deb.sh and the Inno installer.
/dist/
*.deb
*.vsix

# ---- Editor / OS cruft --------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
