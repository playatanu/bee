# 15 — Compiling to a native binary
#
# Every example so far runs on the interpreter:
#
#     bee examples/15_compiling.bee
#
# This one can *also* be compiled to a standalone native executable with beec,
# the ahead-of-time compiler — the result runs on its own, with no interpreter:
#
#     beec examples/15_compiling.bee -o wordcount
#     ./wordcount
#
# See docs/COMPILING.md for the full story.

# Count how often each word appears in a piece of text.
fn word_counts(text) {
    let counts = {}
    for word in text.lower().split(" ") {
        let w = word.trim()
        if len(w) == 0 { continue }
        counts[w] = counts.get(w, 0) + 1
    }
    return counts
}

let text = "the quick brown fox the lazy dog the fox"
let counts = word_counts(text)

# Dict iteration yields keys (in sorted order), so this is deterministic.
for word in counts {
    print(f"{word}: {counts[word]}")
}

# Find the most common word.
let best = ""
let best_n = 0
for word in counts {
    if counts[word] > best_n {
        best = word
        best_n = counts[word]
    }
}
print(f"most common: {best} ({best_n})")
