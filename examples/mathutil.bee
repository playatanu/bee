# mathutil — a small library module imported by other examples.
#
# It is not a standalone program; see 08_modules.bee for how it is used.

let PI = 3.14159265358979

# The square of a number.
fn square(x) {
    return x * x
}

# n! computed iteratively.
fn factorial(n) {
    let result = 1
    for (let i = 2; i <= n; i += 1) {
        result *= i
    }
    return result
}
