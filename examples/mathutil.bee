# mathutil — a small library module imported by 12_modules.bee.
# It is not a standalone program: it only defines things for others to import.
# A name starting with `_` is private to the module and is not exported.

const PI = 3.14159265358979

fn square(x) { return x * x }

fn factorial(n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

fn circle_area(r) { return PI * square(r) }

fn _internal_helper() { return "not exported" }
