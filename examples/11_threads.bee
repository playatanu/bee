# 11 — Threads & the GIL
#
# Bee has a global interpreter lock (like CPython): threads share data
# safely, and blocking calls (sleep, exec, I/O) release the lock so peers run.
#
#     bee examples/11_threads.bee

# There are no lambdas yet, so pass a *named* function to spawn().
fn worker(id, secs) {
    sleep(secs)
    return id + " done"
}

# These sleeps overlap: total wall time ~= the longest, not the sum.
let job1 = spawn(worker, "job-1", 0.10)
let job2 = spawn(worker, "job-2", 0.05)
print(join(job2))              # finishes first
print(join(job1))

# Shared state stays consistent under the GIL — no lost updates.
let counter = [0]
fn bump() {
    for i in range(50000) {
        counter[0] = counter[0] + 1
    }
}
let jobs = []
for i in range(4) {
    jobs.push(spawn(bump))
}
for j in jobs {
    join(j)
}
print("counter (4 x 50000) =", counter[0])

# join() re-raises an error thrown inside a thread.
fn risky() { throw "boom" }
try {
    join(spawn(risky))
} catch (e) {
    print("thread error caught:", e)
}
