# 03 — Strings
#
#     bee examples/03_strings.bee

let s = "The quick brown fox"

print("length:   ", s.len())
print("upper:    ", s.upper())
print("lower:    ", s.lower())
print("words:    ", s.split(" "))
print("replace:  ", s.replace("quick", "slow"))
print("contains: ", s.contains("fox"))
print("starts:   ", s.starts_with("The"))
print("substr:   ", s.substr(4, 5))     # "quick"

# Indexing — negative indices count from the end.
print("first:", s[0], " last:", s[-1])

# Building a string in a loop.
let parts = ["a", "b", "c"]
let joined = ""
for p in parts {
    joined += p + "-"
}
print("joined:", joined)

# Escapes and both quote styles.
print("tab\tseparated")
print('single quotes work too')
