# 07 — Classes & inheritance
#
#     bee examples/07_classes.bee

class Animal {
    init(name) {
        this.name = name
    }
    speak() {
        return this.name + " makes a sound"
    }
    # Defining str() customizes how instances print.
    str() {
        return "Animal(" + this.name + ")"
    }
}

# `extends` for inheritance; `super` calls the parent method.
class Dog extends Animal {
    speak() {
        return super.speak() + ": woof!"
    }
}

class Cat extends Animal {
    speak() {
        return this.name + " says meow"
    }
}

let animals = [Animal("generic"), Dog("Rex"), Cat("Milo")]
for a in animals {
    print(a.speak())
}

print("printed via str():", animals[0])
print("field access:", animals[1].name)
