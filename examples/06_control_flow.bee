# 06 — Control flow
# if / else if / else, while, both for-loop forms, break and continue.

fn classify(n) {
    if n > 0 {
        return "positive"
    } else if n < 0 {
        return "negative"
    } else {
        return "zero"
    }
}
for n in [-3, 0, 7] {
    print(n, "is", classify(n))
}

print("countdown:")
let n = 3
while n > 0 {
    print("  ", n)
    n -= 1
}

print("even squares (C-style for):")
for (let i = 0; i <= 10; i += 2) {
    print("  ", i, "->", i * i)
}

print("break / continue:")
for i in range(10) {
    if i == 3 { continue }      # skip 3
    if i == 6 { break }         # stop at 6
    print("  ", i)
}
