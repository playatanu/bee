# 07 — Pattern matching
# `match` tests a value against cases; a case may list several values, and
# `default` catches the rest.

fn day_kind(day) {
    match day {
        case "sat", "sun" { return "weekend" }
        case "mon", "tue", "wed", "thu", "fri" { return "weekday" }
        default { return "unknown" }
    }
}
for d in ["mon", "sat", "sun", "xyz"] {
    print(f"{d}: {day_kind(d)}")
}

fn bucket(n) {
    match n {
        case 0 { return "empty" }
        case 1, 2, 3 { return "small" }
        default { return "large" }
    }
}
print(bucket(0), bucket(2), bucket(100))
