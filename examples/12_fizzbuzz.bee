# 12 — FizzBuzz
#
# A complete little program: print 1..n, replacing multiples of 3 with "Fizz",
# multiples of 5 with "Buzz", and multiples of both with "FizzBuzz".
#
#     bee examples/12_fizzbuzz.bee

fn fizzbuzz(n) {
    let out = []
    for i in range(1, n + 1) {
        if i % 15 == 0 {
            out.push("FizzBuzz")
        } else if i % 3 == 0 {
            out.push("Fizz")
        } else if i % 5 == 0 {
            out.push("Buzz")
        } else {
            out.push(str(i))
        }
    }
    return out
}

for line in fizzbuzz(20) {
    print(line)
}
