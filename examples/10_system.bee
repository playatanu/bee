# 10 — System library: files, time, randomness, environment, processes
#
#     bee examples/10_system.bee

print("== files ==")
let path = "demo_output.txt"
write_file(path, "alpha\nbeta\ngamma\n")
append_file(path, "delta\n")
print("lines:  ", read_lines(path))
print("exists: ", file_exists(path))
remove_file(path)
print("removed:", not file_exists(path))

print("== time ==")
print("date:", format_time("%Y-%m-%d"))
let t0 = clock()
let sink = 0
for i in range(100000) { sink += i }
print("a loop took", clock() - t0, "seconds")

print("== randomness ==")
random_seed(7)                          # seed => reproducible sequence
print("dice:", random_int(1, 6), random_int(1, 6), random_int(1, 6))
print("pick:", random_choice(["north", "south", "east", "west"]))

print("== environment & processes ==")
set_env("BEE_GREETING", "hi")
print("env:    ", env("BEE_GREETING"))
print("missing:", env("NOPE", "(default)"))
print("args:   ", args())
let result = exec("echo shelled out")
print("exec:   ", result.code, "-", result.output.trim())
