# 08 — Modules
#
# BeeLang resolves modules relative to this file (and a sibling lib/ folder).
# The module imported here lives in mathutil.bee.
#
#     bee examples/08_modules.bee

# Import the whole module object.
import mathutil
print("mathutil.square(5) =", mathutil.square(5))
print("mathutil.PI        =", mathutil.PI)

# Import specific names into scope.
from mathutil import factorial
print("factorial(6) =", factorial(6))

# Import under an alias.
import mathutil as m
print("m.square(9) =", m.square(9))
