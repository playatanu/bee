# 06 — Functions & closures
#
#     bee examples/06_functions.bee

# A plain function.
fn add(a, b) {
    return a + b
}
print("add(2, 3) =", add(2, 3))

# Functions are first-class values.
fn apply(f, x) {
    return f(x)
}
fn double(x) { return x * 2 }
print("apply(double, 21) =", apply(double, 21))

# Closures capture their defining scope.
fn make_counter() {
    let count = 0
    fn tick() {
        count += 1
        return count
    }
    return tick
}
let next = make_counter()
print("counter:", next(), next(), next())

# Closures make handy little factories.
fn adder(n) {
    fn add_n(x) { return x + n }
    return add_n
}
let add10 = adder(10)
print("add10(5) =", add10(5))
