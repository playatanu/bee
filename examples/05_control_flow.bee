# 05 — Control flow
#
#     bee examples/05_control_flow.bee

# if / else if / else
fn classify(n) {
    if n > 0 {
        return "positive"
    } else if n < 0 {
        return "negative"
    } else {
        return "zero"
    }
}
for n in [-3, 0, 7] {
    print(n, "is", classify(n))
}

# while
print("countdown:")
let n = 3
while n > 0 {
    print("  ", n)
    n -= 1
}

# C-style for
print("even squares:")
for (let i = 0; i <= 10; i += 2) {
    print("  ", i, "->", i * i)
}

# for ... in over a range, with break / continue
print("evens, skipping 4, stopping at 8:")
for i in range(10) {
    if i == 4 { continue }
    if i == 8 { break }
    if i % 2 == 0 { write(i, " ") }
}
print("")
