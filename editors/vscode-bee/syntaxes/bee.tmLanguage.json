{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bee",
  "scopeName": "source.bee",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#class-decl" },
    { "include": "#function-decl" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.bee", "match": "#.*$" },
        { "name": "comment.line.double-slash.bee", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bee",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.bee", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.bee",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.bee", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.bee",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "class-decl": {
      "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.other.class.bee" },
        "2": { "name": "entity.name.type.class.bee" },
        "3": { "name": "keyword.other.extends.bee" },
        "4": { "name": "entity.name.type.class.bee" }
      }
    },
    "function-decl": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.fn.bee" },
        "2": { "name": "entity.name.function.bee" }
      }
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.bee", "match": "\\b(if|else|while|for|in|return|break|continue|try|catch|finally|throw)\\b" },
        { "name": "keyword.other.bee", "match": "\\b(let|fn|class|extends|new|import|from|as)\\b" },
        { "name": "keyword.operator.logical.bee", "match": "\\b(and|or|not)\\b" },
        { "name": "variable.language.bee", "match": "\\b(this|super)\\b" }
      ]
    },
    "constants": {
      "name": "constant.language.bee",
      "match": "\\b(true|false|nil)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.bee",
      "match": "\\b(print|write|len|type|str|repr|num|int|bool|abs|floor|ceil|round|sqrt|pow|min|max|range|push|pop|keys|values|ord|chr|input|assert|read_file|read_lines|write_file|append_file|file_exists|remove_file|make_dir|list_dir|clock|time|now|format_time|sleep|random|random_int|random_range|random_choice|random_seed|env|set_env|args|exec|spawn|join)\\b(?=\\s*\\()"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()",
      "name": "entity.name.function.call.bee"
    },
    "operators": {
      "name": "keyword.operator.bee",
      "match": "(\\+=|-=|\\*=|/=|==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!])"
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.bee", "match": ";" },
        { "name": "punctuation.separator.bee", "match": "[,:]" },
        { "name": "punctuation.accessor.bee", "match": "\\." }
      ]
    }
  }
}
